{:deps true

 :builds
 {:app
  {:target :browser
   :output-dir "resources/public/js"
   :asset-path "/js"
   :modules {:main {:init-fn pkm.frontend.core/init!}}
   :devtools {:after-load pkm.frontend.core/reload!
              :http-root "resources/public"
              :http-port 8080
              :proxy-url "http://localhost:3000"}}}
 }
